# ======================================================
# ARC v1.0 Environment Configuration
# Copy this file to .env and update the values.
# ======================================================

# ======================================================
# AI SERVICE
# ======================================================

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face Token (Optional)
HF_RERANKER_TOKEN=your_huggingface_token

# Local Embedding Model
LOCAL_EMBEDDING_MODEL_PATH=/models/bge-base-en-v1.5
ONNX_MODEL_PATH=/models/bge-base-en-v1.5/onnx/model.onnx

# Embedding Configuration
EMBEDDING_MAX_LENGTH=512
ENABLE_TOKEN_DEBUG=false

# ======================================================
# CHUNKING CONFIGURATION
# ======================================================

CHUNK_SIZE=384
CHUNK_OVERLAP=64

MIN_CHUNK_SIZE=150
MAX_CHUNK_SIZE=450

# ======================================================
# MILVUS CONFIGURATION
# ======================================================

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=code_chunks
VECTOR_DIM=768

# ======================================================
# KAFKA CONFIGURATION
# ======================================================

KAFKA_BOOTSTRAP_SERVERS=arc-kafka:29092
KAFKA_INDEX_TOPIC=arc.index
KAFKA_CONSUMER_GROUP=arc-consumer-group

KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

KAFKA_LISTENERS=INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=INTERNAL://arc-kafka:29092,EXTERNAL://localhost:9092

KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# ======================================================
# RETRIEVAL CONFIGURATION
# ======================================================

RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_TOP_K=10
RETRIEVAL_MAX_TOKENS=4000

# ======================================================
# FRONTEND
# ======================================================

NEXT_PUBLIC_API_URL=http://localhost:8080

# ======================================================
# POSTGRES
# ======================================================

POSTGRES_DB=arc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ======================================================
# MINIO
# ======================================================

MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_ADDRESS=minio:9000

# ======================================================
# ZOOKEEPER
# ======================================================

ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ======================================================
# ETCD
# ======================================================

ETCD_ENDPOINTS=etcd:2379

# ======================================================
# SPRING BOOT
# ======================================================

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/arc_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

SPRING_KAFKA_BOOTSTRAP_SERVERS=arc-kafka:29092

SETTINGS_PATHS_STORAGE_PATH=/app/storage

SETTINGS_PATHS_ASK_GENERATIVE_AI_URL=http://ai-service:8000/generate/api