spring.application.name=ARC

spring.datasource.url=ENTER_URL
spring.datasource.username=ENTER_USERNAME
spring.datasource.password=ENTER_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

spring.servlet.multipart.max-file-size=500MB
spring.servlet.multipart.max-request-size=500MB

settings.paths.storage_path=ENTER_ARC_REPOSITORIES
settings.paths.index_url=http://localhost:8000/index
settings.paths.summary_url=http://localhost:8000/summary
